# ─────────────────────────────────────────────────────────────────────────────
# TalentOS environment configuration
#
# Copy to `.env.local` for local development. Never commit real values.
# Every variable below is read server-side only, except those prefixed with
# NEXT_PUBLIC_ (which are inlined into the browser bundle — put no secrets there).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin of the deployment. Used for cookie scoping and absolute links.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance: Supabase, Neon, RDS, or a local cluster.
# Supabase: use the *pooled* connection string (port 6543) for serverless.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentos
# Set to "require" for managed providers that enforce TLS (Supabase, Neon).
DATABASE_SSL=disable
# Connection pool ceiling per serverless instance. Keep low on Vercel.
DATABASE_POOL_MAX=5

# ── Authentication ───────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this invalidates every active session.
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Session lifetime in days.
AUTH_SESSION_TTL_DAYS=30
# Comma-separated emails that receive admin access on registration.
ADMIN_EMAILS=

# ── AI provider ──────────────────────────────────────────────────────────────
# Which provider the interview engine uses: anthropic | openai | gemini
# Leave unset (or set to "none") to run in Offline Heuristic mode, which uses a
# deterministic local engine instead of an LLM. Heuristic mode is clearly
# labelled throughout the UI and is intended for development and CI only.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional per-task model overrides. Defaults are defined in src/lib/ai/models.ts
# and route cheap tasks to small models, evaluation to large ones.
# AI_MODEL_REASONING=claude-opus-5
# AI_MODEL_STANDARD=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5

# Hard ceiling on spend per interview, in USD. The engine degrades gracefully
# (stops asking new questions and moves to evaluation) once exceeded.
AI_MAX_COST_PER_INTERVIEW_USD=1.50
# Request timeout for a single AI call, milliseconds.
AI_TIMEOUT_MS=90000

# ── File uploads ─────────────────────────────────────────────────────────────
# Max resume upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES=5242880

# ── Rate limiting ────────────────────────────────────────────────────────────
# In-memory limiter is used by default. For multi-instance deployments, point
# this at Postgres so limits are shared across instances.
RATE_LIMIT_BACKEND=postgres

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
